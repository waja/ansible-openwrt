set -eu
target='{{ storage_mount_target }}'
probe_output='{{ storage_mount_probe_output }}'
device="$(printf '%s\n' "$probe_output" | sed -n 's/^device=//p')"
expected_fstype="{{ storage_mount_fstype }}"
target_parent="$target"
while [ "$target_parent" != "/" ]; do
  if [ -L "$target_parent" ]; then
    echo "Mount target path contains symbolic link $target_parent" >&2
    exit 1
  fi
  target_parent="${target_parent%/*}"
  [ -n "$target_parent" ] || target_parent="/"
done
if [ -e "$target" ] && [ ! -d "$target" ]; then
  echo "Mount target $target exists and is not a directory" >&2
  exit 1
fi
existing_target="$(awk -v target="$target" \
  '$2 == target {print $1 "|" $3}' /proc/mounts)"
if [ -n "$existing_target" ]; then
  existing_source="$(printf '%s\n' "$existing_target" | cut -d '|' -f 1)"
  existing_fstype="$(printf '%s\n' "$existing_target" | cut -d '|' -f 2)"
  [ "$existing_source" = "$device" ] && \
    [ "$existing_fstype" = "$expected_fstype" ] || {
    echo "Mount target $target is already used by" \
      "$existing_source ($existing_fstype)" >&2
    exit 1
  }
else
  existing_device_mount="$(awk -v device="$device" \
    '$1 == device {print $2}' /proc/mounts)"
  [ -z "$existing_device_mount" ] || {
    echo "Device $device is already mounted at $existing_device_mount" >&2
    exit 1
  }
  if [ -e "$target" ]; then
    target_contents="$(find "$target" -mindepth 1 -maxdepth 1 -print)" || {
      echo "Unable to inspect mount target $target" >&2
      exit 1
    }
  else
    target_contents=""
  fi
  if [ -n "$target_contents" ]; then
    echo "Mount target $target is not empty; refusing to" \
      "hide existing data" >&2
    exit 1
  fi
fi
