{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard"
  ],
  "baseBranchPatterns": [
    "development"
  ],
  "assignees": [
    "waja"
  ],
  "reviewers": [
    "waja"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "python"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "groupName": "container base images"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the ShellCheck version installed by its GitHub Action",
      "managerFilePatterns": [
        "/\\.github/workflows/lint-scripts-docs\\.yml$/"
      ],
      "matchStrings": [
        "- name: Lint POSIX shell scripts[\\s\\S]*?version: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "koalaman/shellcheck",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the pinned pip-tools lockfile generator",
      "managerFilePatterns": [
        "/^requirements\\/ci\\/pip-tools\\.in$/"
      ],
      "matchStrings": [
        "pip-tools==(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "pip-tools",
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    }
  ],
  "pip-compile": {
    "managerFilePatterns": [
      "/^requirements\\/ci\\/(lint|ansible-test|molecule)\\.txt$/"
    ]
  },
  "pip_requirements": {
    "enabled": false
  }
}
